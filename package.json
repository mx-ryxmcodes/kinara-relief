{
  "name": "flood-relief-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "dev": "vite",
    "start": "node server/server.js",
    "api": "node server/server.js",
    "user": "node server/user-cli.js",
    "api:json": "json-server --watch db.json --port 3001",
    "seed": "node server/build-db.js",
    "check:seed": "node server/check-seed.js",
    "dev:all": "concurrently -k -n api,web \"npm run api\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "jsdom": "^25.0.1",
    "json-server": "0.17.4",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
